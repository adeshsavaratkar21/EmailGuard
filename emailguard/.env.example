# Local default: DATABASE_URL=sqlite:///./emailguard.db
# Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./emailguard.db
EMAILGUARD_MAX_EMAIL_BYTES=10485760
EMAILGUARD_MAX_URLS_PER_EMAIL=50
EMAILGUARD_MAX_ACTIVE_URLS_PER_EMAIL=3
EMAILGUARD_URL_TIMEOUT_SECONDS=2.5
EMAILGUARD_MAX_URL_REDIRECTS=3
EMAILGUARD_ALLOW_ACTIVE_URL_CHECKS=false
EMAILGUARD_DNS_LOOKUPS=false
EMAILGUARD_DKIM_DNS_LOOKUPS=false
# JSON object overrides, e.g. {"lookalike_domain":30,"dmarc_fail":22}
EMAILGUARD_SCORING_WEIGHTS={}
EMAILGUARD_SAFE_THRESHOLD=80
EMAILGUARD_SUSPICIOUS_THRESHOLD=50
