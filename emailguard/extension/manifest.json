{
  "manifest_version": 3,
  "name": "EmailGuard — Link Safety",
  "version": "1.0.0",
  "description": "Check the current page URL with the EmailGuard security engine.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "Analyze this page with EmailGuard",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
